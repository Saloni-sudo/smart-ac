# server/.env.example — copy to server/.env and fill in real values.

PORT=4000                                # port the backend listens on (defaults to 4000 if unset)
DRIVER=sim                               # which DeviceDriver to use; only "sim" is supported today
CLIENT_ORIGIN=https://your-app.vercel.app # deployed frontend origin allowed by Socket.io CORS (localhost:5173 is always allowed)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/smartac # Atlas connection string; readings are stored here
